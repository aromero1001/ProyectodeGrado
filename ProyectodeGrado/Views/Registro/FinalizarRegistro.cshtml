
@{
    ViewBag.Title = "REGISTRO EXITOSO";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <title>REGISTRO - Sistema de Votación Online</title>
</head>
<body>
    <div id="wrapper">
        <div class="jumbotron">
            <h3> @ViewBag.Title </h3>
        </div>
        <div class="alert alert-success alert-dismissable">
            <strong>¡Registro exitoso!</strong> Gracias por registrarse en el sistema.
        </div>
        <p style="text-align:center">
            <i class="fa fa-check-circle fa-5x" style="font-size: 12em; text-align:center; color:#1fa67b"></i>
        </p>
    </div>
</body>
</html>

