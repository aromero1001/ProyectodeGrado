
@model ProyectodeGrado.Models.SVModel.USUARIO

@{
    ViewBag.Title = "REGISTRO";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <title>Registro - Sistema de Votación</title>
</head>
<body>
    <div id="wrapper">
    <div class="jumbotron">
        <h2> <strong> @ViewBag.Title </strong> </h2>
    </div>
        <div class="control col-lg-12 col-md-12">
            <div class="alert alert-warning alert-dismissable">
                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                <a href="#" class="alert-link">¡Advertencia! debe llenar todos los datos para registrarse.</a>.
            </div>
            <form role="form" @*action="javascript:;"*@ method="post" id="login-form" autocomplete="off" action="@Url.Action("Registro", "Registro")">
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    <hr />
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div id="accordion" role="tablist" aria-multiselectable="true">
                        <div class="panel panel-default">
                            <div class="panel-heading" role="tab" id="headingOne">
                                <h4 class="panel-title">
                                    <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                        DATOS DE USUARIO
                                    </a>
                                </h4>
                            </div>
                            <div id="collapseOne" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingTwo">

                                <div class="form-group" style="visibility: hidden">
                                    @Html.LabelFor(model => model.ID_ESTATUS, "ID_ESTATUS", htmlAttributes: new { @class = "control-label col-md-2" })

                                    <div class="col-md-10">
                                        @Html.EditorFor(model => model.ID_ESTATUS, new { htmlAttributes = new { @class = "form-control", @Value = 1 } })
                                        @Html.ValidationMessageFor(model => model.ID_ESTATUS, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                @*<div>
                                    @Html.LabelFor(model => model.CEDULA, "CEDULA", htmlAttributes: new { @class = "control-label col-md-2" })
                                </div>*@
                                <div class="form-group form-inline">
                                    <div class="col-md-10">
                                        <label for="pwd">Cédula</label>
                                        @Html.TextBoxFor(model => model.CEDULA, null, htmlAttributes: new { @class = "form-control", @Value = ViewBag.cedula, @readonly = "readonly" })
                                        @Html.ValidationMessageFor(model => model.CEDULA, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                @*<div>
                                    @Html.LabelFor(model => model.NOMBRE, htmlAttributes: new { @class = "control-label col-md-2" })
                            </div>*@
                                <div class="form-group form-inline">
                                   
                                    <div class="col-md-10">
                                        <label for="pwd">Nombre:</label>
                                        @Html.EditorFor(model => model.NOMBRE, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.NOMBRE, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                @*<div>
                                    @Html.LabelFor(model => model.APELLIDO, htmlAttributes: new { @class = "control-label col-md-2" })
                                </div>*@
                                <div class="form-group form-inline">
                                    <div class="col-md-10">
                                        <label for="pwd">Apellido:</label>
                                        @Html.EditorFor(model => model.APELLIDO, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.APELLIDO, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @*@Html.LabelFor(model => model.FECHA_NACIMIENTO, htmlAttributes: new { @class = "control-label col-md-2" })*@
                                </div>
                                <div class="form-group form-inline">
                                    <div class="col-md-10 form-inline">
                                        <label for="pwd">Fecha de nacimiento:</label>
                                        @Html.EditorFor(model => model.FECHA_NACIMIENTO, new { htmlAttributes = new { @class = "form-control default-date-picker", @type = "date" } })
                                        @Html.ValidationMessageFor(model => model.FECHA_NACIMIENTO, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                @*<div>
                                    @Html.LabelFor(model => model.GENERO, htmlAttributes: new { @class = "control-label col-md-2" })
                                </div>*@
                                <div class="form-group form-inline">
                                    <div class="col-md-10">
                                        <label for="pwd">Género:</label>
                                        <h6>Femenino: </h6>  @Html.RadioButtonFor(model => model.GENERO, "F")
                                        <h6>Masculino: </h6> @Html.RadioButtonFor(model => model.GENERO, "M")
                                        @Html.ValidationMessageFor(model => model.GENERO, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                @*<div>
                                    @Html.LabelFor(model => model.NOMBRE_USUARIO, htmlAttributes: new { @class = "control-label col-md-2" })
                                </div>*@
                                <div class="form-group form-inline">
                                    <div class="col-md-10">
                                        <label for="pwd">Nombre de usuario:</label>
                                        @Html.EditorFor(model => model.NOMBRE_USUARIO, new { htmlAttributes = new { @class = "form-control" } })
                                        <span class="glyphicon glyphicon-user form-control-feedback"></span>
                                        @Html.ValidationMessageFor(model => model.NOMBRE_USUARIO, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                @*<div>
                                    @Html.LabelFor(model => model.CLAVE, htmlAttributes: new { @class = "control-label col-md-2" })
                                </div>*@
                                <div class="form-group form-inline">
                                    <div class="col-md-10 ">
                                        <label for="pwd">Contraseña:</label>
                                        @Html.Password("CLAVE") <span class="glyphicon glyphicon-lock form-control-feedback"></span>

                                        @Html.ValidationMessageFor(model => model.CLAVE, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                @*<div>
                                    @Html.LabelFor(model => model.CORREO, htmlAttributes: new { @class = "control-label col-md-2" })
                                </div>*@
                                <div class="form-group form-inline">
                                    <div class="col-md-10">
                                        <label for="pwd">Correo electrónico:</label>
                                        @Html.EditorFor(model => model.CORREO, new { htmlAttributes = new { @class = "form-control", @placeholder = "usuario@email.com" } })
                                        <span class="glyphicon glyphicon-envelope form-control-feedback"></span>

                                        @Html.ValidationMessageFor(model => model.CORREO, "", new { @class = "text-danger" })
                                    </div>
                                </div>


                                <div class="form-group form-inline">
                                    <div class="col-md-10" style="visibility: hidden">
                                        @Html.TextBoxFor(model => model.FOTO_PERFIL, new { type = "file" })
                                        @Html.ValidationMessageFor(model => model.FOTO_PERFIL, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                @*<div>
                                    @Html.LabelFor(model => model.DESCRIPCION, htmlAttributes: new { @class = "control-label col-md-2" })
                                </div>*@
                                <div class="form-group form-inline">
                                    <div class="col-md-10">
                                        <label for="pwd">Descripción:</label>
                                        @Html.EditorFor(model => model.DESCRIPCION, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.DESCRIPCION, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group" style="visibility: hidden">
                                    @Html.LabelFor(model => model.ID_ROL, "ID_ROL", htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-10">
                                        @Html.EditorFor(model => model.ID_ROL, new { htmlAttributes = new { @class = "form-control", @Value = 3 } })
                                        @Html.ValidationMessageFor(model => model.ID_ROL, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group" style="visibility: hidden">
                                    @Html.LabelFor(model => model.INTENTOS, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-10">
                                        @Html.EditorFor(model => model.INTENTOS, new { htmlAttributes = new { @class = "form-control", @Value = 0 } })
                                        @Html.ValidationMessageFor(model => model.INTENTOS, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="panel panel-default">
                            <div class="panel-heading" role="tab" id="headingTwo">
                                <h4 class="panel-title">
                                    <a class="collapsed" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                        DATOS ACADEMICOS
                                    </a>
                                </h4>
                            </div>
                            <div id="collapseTwo" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingTwo">

                                @*<div>
                                    @Html.LabelFor(model => model.TIPO_ESTUDIO, htmlAttributes: new { @class = "control-label col-md-2" })
                                </div>*@
                                <div class="form-group form-inline">
                                    <div class="col-md-10">
                                        <label for="pwd">Tipo de estudio:</label>
                                        @Html.EditorFor(model => model.TIPO_ESTUDIO, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.TIPO_ESTUDIO, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                @*<div>
                                    @Html.LabelFor(model => model.NIVEL_ESTUDIO, htmlAttributes: new { @class = "control-label col-md-2" })
                                </div>*@
                                <div class="form-group form-inline">
                                    <div class="col-md-10 ">
                                        <label for="pwd">Nivel de estudio: </label>
                                        @Html.EditorFor(model => model.NIVEL_ESTUDIO, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.NIVEL_ESTUDIO, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                @*<div>
                                    @Html.LabelFor(model => model.FACULTAD_SECCION, htmlAttributes: new { @class = "control-label col-md-2" })
                                </div>*@
                                <div class="form-group form-inline">
                                    <div class="col-md-10 ">
                                        <label for="pwd">Facultad/Sección:</label>
                                        @Html.EditorFor(model => model.FACULTAD_SECCION, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.FACULTAD_SECCION, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="form-group form-inline">
                            <div class="col-md-offset-2 col-md-10">
                                <button type="submit" class="btn btn-danger">Siguiente<span class="glyphicon glyphicon-arrow-right"> </span></button>
                                <button type="reset" class="btn btn-primary">Resetear<i class="fa fa-refresh" aria-hidden="true"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
