
@{
    ViewBag.Title = "ELECCIÓN";
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Elecciones - Sistema de Votación</title>
    <link href="~/Content/font-awesome.min.css" rel="stylesheet" />
    <link href="css/bootstrap.css" rel="stylesheet">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
</head>
<body>
    <div id="wrapper">

        <div class="jumbotron">
            <h3> @ViewBag.Title </h3>
        </div>

        @if (ViewBag.Exitoso == true)
        {
            <div class="alert alert-success alert-dismissable">
                <strong>¡Cambio exitoso!</strong> Usted ha cambiado la configuración de las elecciones exitosamente.
            </div>
        }
        @if (@ViewBag.Exitoso == false)
        {
            <div class="alert alert-danger alert-dismissable">
                <strong>¡Error!</strong> Ha ocurrido un error en la configuración, por favor, inténtelo nuevamente.
            </div>
        }

        @if (ViewBag.Configurado == false)
        {
            <div class="alert alert-warning alert-dismissable">
                <strong>¡Advertencia!</strong> Usted no ha configurado las elecciones. Por favor, presione el botón de "configurar" para poder hacerlo.
            </div>
        }

        @if (ViewBag.fecha == false)
        {
            <div class="alert alert-danger alert-dismissable">
                <strong>¡Error!</strong> La fecha de inicio debe ser anterior a la fecha final de las elecciones. Asimismo, la fecha final debe ser posterior a la fecha de hoy. Por favor, inténtelo nuevamente.
            </div>
        }
        <div class="alert alert-info alert-dismissable">
            <strong>¡Información!</strong> En esta sección usted podrá ver la configuración actual de las elecciones. Si desea editar su configuración, presione el botón "configurar".
        </div>

        <div class="col-lg-12 col-md-12">
            <div class="span4 offset4 well">
                <form role="form" method="post" id="login-form" autocomplete="off">
                    <h5>Configurar elecciones</h5>
                    <div class="form-group">
                        <label for="pwd">Título de la elección:</label>
                        <input type="text" name="titulo" id="titulo" class="form-control" value="@(ViewBag.Titulo)" disabled>
                    </div>
                    <div class="form-group">
                        <label for="pwd">Fecha de inicio:</label>
                        <input type="text" name="fecha_inicio" id="fecha_inicio" class="form-control" value="@(ViewBag.FechaInicio)" disabled>
                    </div>
                    @*<div class="form-group">
                        <label for="pwd">Hora de inicio:</label>
                        <input type="time" name="hora_inicio" id="hora_inicio" class="form-control">
                    </div>*@
                    <div class="form-group">
                        <label for="pwd">Fecha de fin:</label>
                        <input type="text" name="fecha_fin" id="fecha_fin" class="form-control" value="@(ViewBag.FechaFin)" disabled>
                    </div>
                    <div class="form-group">
                        <label for="pwd">Hora de finalización:</label>
                        <input type="time" name="hora" id="hora" class="form-control" value="@(ViewBag.Hora)" disabled>
                    </div>
                    <div class="form-group">
                        <label for="pwd">Tipo de instituto:</label>
                        <input type="text" name="t_institucion" id="t_institucion" class="form-control" value="@(ViewBag.TipoInstituto)" disabled>
                    </div>
                    <div class="form-group">
                        <label for="pwd">Nombre de la institución:</label>
                        <input type="text" name="nombre_institucion" id="nombre_institucion" class="form-control" value="@(ViewBag.NombreInstituto)" disabled>
                    </div>
                    @*<div class="form-group">
                        <label for="pwd">Descripción de la elección:</label>
                        <input type="text" name="descripcion" id="descripcion" class="form-control">
                    </div>*@
                    <div class="form-group">
                        <label for="exampleTextarea">Descripción</label>
                        <textarea class="form-control" name="descripcion" id="descripcion" rows="3" value="@(ViewBag.Descripcion)" disabled>@(ViewBag.Descripcion)</textarea>
                    </div>
                    <div class="form-group">
                        <label for="pwd">Duración del voto:</label>
                        <input type="text" name="duracion" id="duracion" class="form-control" value="@(ViewBag.Duracion)" disabled>
                    </div>
                    <div class="form-group">
                        <label for="pwd">Tipo de elección:</label>
                        <input type="text" name="eleccion" id="eleccion" class="form-control" value="@(ViewBag.TipoEleccion)" disabled>
                    </div>

                        @*<div class="input-group image-preview form-group">
                            <input type="text" class="form-control image-preview-filename"> <!-- don't give a name === doesn't send on POST/GET -->
                            <span class="input-group-btn">
                                <!-- image-preview-clear button -->
                                <button type="button" class="btn btn-default image-preview-clear" style="display:none;">
                                    <span class="glyphicon glyphicon-remove"></span> Reestablecer
                                </button>
                                <!-- image-preview-input -->
                                <div class="btn btn-default image-preview-input form-group">
                                    <span class="glyphicon glyphicon-folder-open"></span>
                                    <span class="image-preview-input-title">Examinar</span>
                                    <input type="file" accept="image/png, image/jpeg, image/gif" name="logo" /> <!-- rename it -->
                                </div>
                            </span>
                        </div>*@
                    <div>
                        <a href="@Url.Action("ConfigurarElecciones","Administrar")" class="btn btn-custom btn-lg btn-block" role="button" style="margin-bottom:15px">Configurar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>