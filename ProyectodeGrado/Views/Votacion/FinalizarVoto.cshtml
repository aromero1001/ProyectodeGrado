
@{
    ViewBag.Title = "VOTO EXITOSO";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <title>VOTACIÓN - Sistema de Votación Online</title>
</head>
<body>
    <div id="wrapper">
        <div class="jumbotron">
            <h3> @ViewBag.Title </h3>
        </div>
        <div class="alert alert-success alert-dismissable">
            <strong>¡Voto exitoso!</strong> Gracias por votar.
        </div>
        <p style="text-align:center">
            <i class="fa fa-check-circle fa-5x" style="font-size: 12em; text-align:center; color:#1fa67b"></i>
        </p>
    </div>
</body>
</html>

