@model ProyectodeGrado.Models.SVModel.CANDIDATO

@{
    ViewBag.Title = "VOTACIÓN POR CANDIDATOS";
    Layout = "~/Views/Shared/_LayoutVoto.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <title>Votación - Sistema de Votación Online</title>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Refresh" content="20; @Url.Action("VotoNulo", "Votacion")" />
</head>
<body>
    <div id="wrapper">
        <div class="jumbotron">
            <h3> @ViewBag.Title </h3>
        </div>
    </div>
    <form role="form" method="post" id="login-form" autocomplete="off" action="@Url.Action("VotarCandidato", "Votacion",new { id = Model.ID_USUARIO})">

        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <h4>Votacion por Candidato</h4>
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.ID_PARTIDO)

            <div class="form-group">
                <div class="col-md-10">
                    <label for="pwd">Candidato:</label>
                    @*@Html.LabelFor(model => model.USUARIO.NOMBRE, "NOMBRE", htmlAttributes: new { @class = "control-label col-md-2" })*@
                    @Html.EditorFor(model => model.USUARIO.NOMBRE, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", @disable = true } })
                    @Html.ValidationMessageFor(model => model.ID_USUARIO, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-10">
                    <label for="pwd">Partido:</label>
                    @*@Html.LabelFor(model => model.PARTIDO.NOMBRE, "NOMBRE", htmlAttributes: new { @class = "control-label col-md-2" })*@
                    @Html.EditorFor(model => model.PARTIDO.NOMBRE, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", @disable = true } })
                    @Html.ValidationMessageFor(model => model.USUARIO, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Votar" class="btn btn-default" />
                </div>
            </div>
        </div>
    </form>
    <div>
        @*@Html.ActionLink("Regresar", "Candidato")*@
    </div>
</body>
</html>
