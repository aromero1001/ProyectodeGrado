 @model IEnumerable<ProyectodeGrado.Models.SVModel.OPCION_PROPUESTA>
   @{

       ViewBag.Title = "VOTACIÓN POR PROPUESTA";
       Layout = "~/Views/Shared/_LayoutVoto.cshtml";
    }
   
        <!DOCTYPE html>

        <html>
        <head>
            <title>Votación - Sistema de Votación Online</title>
            <meta name="viewport" content="width=device-width" />
            <meta http-equiv="Refresh" content="@ViewBag.segundos; @Url.Action("VotoNulo", "Votacion")" />
             
        </head>
        <body>
            <div id="wrapper">
                <div class="jumbotron">
                    <h3> @ViewBag.Title </h3>
                </div>
            </div>
            <div>
                <h3> Elija la opción de su preferencia: </h3>
            </div>
            <div>
                    @using ProyectodeGrado.Models.SVModel;
                    @using (SVContext db = new SVContext())
                    {
                        var propuesta = (from p in db.PROPUESTA select p).FirstOrDefault();
                        <h3 style="text-align:center"> Propuesta: <strong>@propuesta.TITULO</strong></h3>
                        <h4 style="text-align:center"> Descripción de la propuesta: ¿@propuesta.DESCRIPCION</h4>
                    }
            </div>
            <table class="table">

                <tr>
                    <th>

                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OPCION)
                    </th>
                    <th></th>
                </tr>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <i class="fa fa-th-list" aria-hidden="true"></i>
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.OPCION)
                        </td>
                        <td>
                            @Html.ActionLink("Seleccionar", "Votar", new { id = item.ID_OPCION }, new { @class = "btn btn-success" })
                        </td>
                    </tr>
                }

            </table>
         


        </body>
   </html>

