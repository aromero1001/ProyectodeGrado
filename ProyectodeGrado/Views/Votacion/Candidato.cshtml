@model IEnumerable<ProyectodeGrado.Models.SVModel.CANDIDATO>

@{
    ViewBag.Title = "VOTACIÓN POR CANDIDATOS";
    Layout = "~/Views/Shared/_LayoutVoto.cshtml";
}


<!DOCTYPE html>

<html>
<head>
    <title>Votación - Sistema de Votación Online</title>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Refresh" content="@ViewBag.segundos; @Url.Action("VotoNulo", "Votacion")" />

</head>
<body>
    <div id="wrapper">
        <div class="jumbotron">
            <h3> @ViewBag.Title </h3>
        </div>
    </div>
    <div>
        <h3> Elija el candidato de su preferencia: </h3>
    </div>
    <table class="table">
        <tr>
            <th>

            </th>
            <th>
                NOMBRE DE PARTIDO
                @*@Html.DisplayNameFor(model => model.PARTIDO.NOMBRE)*@
            </th>
            <th>
                NOMBRE
            </th>
            <th>
                APELLIDO
            </th>
            <th>
                DESCRIPCIÓN
            </th>
            <th></th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <i class="fa fa-user" aria-hidden="true"></i>
                </td>
               <td>
                    @Html.DisplayFor(modelItem => item.PARTIDO.NOMBRE)
                </td>
                <td>
                    @Html.DisplayFor(model => item.USUARIO.NOMBRE)
                </td>
                <td>
                    @Html.DisplayFor(model => item.USUARIO.APELLIDO)
                </td>
                <td>
                    @Html.DisplayFor(model => item.USUARIO.DESCRIPCION)
                </td>
                <td>
                    @Html.ActionLink("Seleccionar", "VotarCandidato", new { id = item.ID_MIEMBRO }, new { @class = "btn btn-success" })
                </td>
            </tr>


        }

    </table>
</body>
</html>