
@{
    ViewBag.Title = "VOTACIÓN";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <title>Votación - Sistema de Votación Online</title>
</head>
<body>
    <div id="wrapper">
        <div class="jumbotron">
            <h3> @ViewBag.Title </h3>
        </div>
        <div class="alert alert-danger alert-dismissable">
            <strong>¡Usted ya ha ejercido su voto!</strong> Usted no puede votar más de una vez.
        </div>
        <p style="text-align:center">
            <i class="fa fa-ban fa-5x" style="font-size: 12em; text-align:center; color:#D50000"></i>
        </p>
    </div>
</body>
</html>
 