@model IEnumerable<ProyectodeGrado.Models.SVModel.PARTIDO>

    @{
        ViewBag.Title = "VOTACIÓN POR PARTIDOS";
        Layout = "~/Views/Shared/_LayoutVoto.cshtml";
    }


<!DOCTYPE html>

<html>
<head>
    <title>Votación - Sistema de Votación Online</title>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Refresh" content="@ViewBag.segundos; @Url.Action("VotoNulo", "Votacion")" />

</head>
<body>
    <div id="wrapper">
        <div class="jumbotron">
            <h3> @ViewBag.Title </h3>
        </div>
    </div>
    <div>
        <h3> Elija el partido de su preferencia: </h3>
    </div>
<table class="table">
    <tr>
        <th>

        </th>
        <th>
            @Html.DisplayNameFor(model => model.NOMBRE)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DESCRIPCION)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                <i class="fa fa-flag" aria-hidden="true"></i>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TIPO_ELECCION.NOMBRE)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NOMBRE)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DESCRIPCION)
            </td>
            <td>
                @Html.ActionLink("Seleccionar", "VotarPartido", new { id = item.ID_PARTIDO }, new { @class = "btn btn-success" })
            </td>
        </tr>
    }

</table>
</body>
</html>