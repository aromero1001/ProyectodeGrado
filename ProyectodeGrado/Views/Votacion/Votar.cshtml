@model ProyectodeGrado.Models.SVModel.OPCION_PROPUESTA


@{
    ViewBag.Title = "VOTACIÓN POR PROPUESTA";
    Layout = "~/Views/Shared/_LayoutVoto.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <title>Votación - Sistema de Votación Online</title>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Refresh" content="20; @Url.Action("VotoNulo", "Votacion")" />
</head>
<body>
    <div id="wrapper">
        <div class="jumbotron">
            <h3> @ViewBag.Title </h3>
        </div>
    </div>
    <form role="form" method="post" id="login-form" autocomplete="off" action="@Url.Action("Votar", "Votacion", new { opc = Model.ID_OPCION })">
        @Html.AntiForgeryToken()
       
        
        <div class="form-horizontal">
            <h4>Votacion por Propuesta</h4>
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.ID_OPCION, new { htmlAttributes = new { @name = "idopc" } })
           

            <div class="form-group">
                <div class="col-md-10">
                    @Html.EditorFor(model => model.OPCION, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", @disable=true } })
                    @Html.ValidationMessageFor(model => model.OPCION, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Votar" class="btn btn-default" />
                </div>
            </div>
        </div>
        </form>

        <div>
            @Html.ActionLink("Regresar", "Index")
        </div>
</body>
</html>


