@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <!-- Add custom CSS here -->
    @*<link href="~/Content/Site.css" rel="stylesheet" />*@
    <link href="~/Content/font-awesome.min.css" rel="stylesheet" />

    <!-- Bootstrap core CSS -->
    <link href="css/bootstrap.css" rel="stylesheet">

    @*<link rel="stylesheet" href="font-awesome/css/font-awesome.min.css">*@
    <!-- Page Specific CSS -->
    @*<link rel="stylesheet" href="http://cdn.oesmith.co.uk/morris-0.4.3.min.css">*@
</head>

<body>
    <div id="wrapper">
        <!-- Sidebar -->
        <div class="container">
            <div class="col-lg-4 col-md-4 col-xs-12">
                <nav class="navbar navbar-inverse navbar-fixed-top" role="navigation">

                    <!-- Brand and toggle get grouped for better mobile display -->
                    <div class="navbar-header">
                        <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-ex1-collapse">
                            <span class="sr-only">Toggle navigation</span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                        </button>
                        <a class="navbar-brand" href="@Url.Action("Loggedin", "Cuenta")"><i class="fa fa-bars" aria-hidden="true"></i> MENÚ</a>
                    </div>

                    <!-- Collect the nav links, forms, and other content for toggling -->
                    <div class="collapse navbar-collapse navbar-ex1-collapse">
                        <ul class="nav navbar-nav side-nav">
                            <li class="#"><a href="@Url.Action("Loggedin", "Cuenta")"><i class="fa fa-home" aria-hidden="true"></i> Inicio</a></li>
                           
                            @using ProyectodeGrado.Models.SVModel
                            @using (SVContext db = new SVContext())
                            {
                                var eleccion = (from e in db.ELECCION
                                                select e).FirstOrDefault();
                                if (eleccion.ID_TIPO_ELECCION == 1)
                                {
                                    <li><a href="@Url.Action("ResultadoCandidatosAdmin", "Resultados")"><i class="fa fa-line-chart" aria-hidden="true"></i> Ver resultados</a></li>
                                }
                                if (eleccion.ID_TIPO_ELECCION == 2)
                                {
                                    <li><a href="@Url.Action("ResultadosPartidosAdmin", "Resultados")"><i class="fa fa-line-chart" aria-hidden="true"></i> Ver resultados</a></li>
                                }
                                if (eleccion.ID_TIPO_ELECCION == 3)
                                {
                                    <li><a href="@Url.Action("ResultadoPropuestaAdmin", "Resultados")"><i class="fa fa-line-chart" aria-hidden="true"></i> Ver resultados</a></li>
                                }
                            }
                            <li class="dropdown">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="fa fa-cogs" aria-hidden="true"></i> Panel de control <b class="caret"></b></a>
                                <ul class="dropdown-menu">
                                    <li><a href="@Url.Action("AdministrarUsuarios", "Administrar")">Administrar usuarios</a></li>
                                    @using ProyectodeGrado.Models.SVModel
                                    @using (SVContext db = new SVContext())
                                    {
                                        var eleccion = (from e in db.ELECCION
                                                        select e).FirstOrDefault();
                                        if ((eleccion.ID_TIPO_ELECCION == 2) ||(eleccion.ID_TIPO_ELECCION == 1))
                                        {
                                            <li><a href="@Url.Action("AdministrarPartido", "Administrar")">Gestionar partidos</a></li>
                                            <li><a href="@Url.Action("VerPartidos", "Administrar")">Ver partidos</a></li>
                                            <li><a href="@Url.Action("VerCandidatos", "Administrar")">Ver candidatos</a></li>
                                        }
                                        if (eleccion.ID_TIPO_ELECCION == 3)
                                        {
                                            <li><a href="@Url.Action("AdministrarPropuestas", "Administrar")">Gestionar propuesta</a></li>
                                        }
                                    }
                                    <li><a href="@Url.Action("Elecciones", "Administrar")">Configuración de sistema</a></li>
                                </ul>
                            </li>
                            <li><a href="@Url.Action("LogOut", "Cuenta")"><i class="fa fa-power-off"></i> Cerrar sesión</a></li>
                        </ul>

                        <ul class="nav navbar-nav navbar-right navbar-user">
                            <li class="dropdown user-dropdown">

                                <a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="fa fa-user" style="color:#ffffff;"></i><span> @ViewBag.Nombre </span><b class="caret" style="color:#ffffff;"></b></a>

                                <ul class="dropdown-menu">
                                    <li><a href="@Url.Action("VerPerfil", "Cuenta")"><i class="fa fa-user"></i> Ver perfil</a></li>
                                    <li><a href="@Url.Action("Configuracion","Cuenta")"><i class="fa fa-cog"></i> Configuración</a></li>
                                    <li class="divider"></li>
                                    <li><a href="@Url.Action("LogOut", "Cuenta")"><i class="fa fa-power-off"></i> Cerrar sesión</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div><!-- /.navbar-collapse -->
                </nav>
            </div>
        </div>
        <div class="container body-content col-lg-12">
            @RenderBody()
            <hr />
        </div>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    <footer>
        <p>&copy; @DateTime.Now.Year - Sistema de Votación en Línea.</p>
    </footer>
</body>
</html>