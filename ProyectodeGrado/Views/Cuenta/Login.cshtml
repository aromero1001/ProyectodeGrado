@{
    ViewBag.Title = "SISTEMA DE VOTACIÓN";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Inicio - Sistema de Votación Online</title>
</head>
<body>
    <div id="wrapper">
        <div class="jumbotron">
            <h3> @ViewBag.Title </h3>
        </div>

        @if (ViewBag.Logout == true)
        {
            <div class="alert alert-success alert-dismissable">
                <strong>¡Usted ha cerrado sesión!</strong> Gracias por ingresar a nuestro sistema. Vuelva pronto.
            </div>
        }

        @if (ViewBag.Coinciden == true)
        {
            <div class="alert alert-success alert-dismissable">
                <strong>¡Cambio de clave exitoso!</strong> Inicie sesión con su nueva clave.
            </div>
        }
        <section id="login">
            <div class="container">
                <div class="row">
                    @*<div class="col-xs-12">*@
                    <div class="col-md-6 col-xs-12">
                        <div class="span4 offset4 well">
                            <div class="form-wrap">
                                @using ProyectodeGrado.Models.SVModel;
                                @using (SVContext db = new SVContext())
                                {
                                    var eleccion = (from i in db.ELECCION
                                                    where i.ID_ELECCION == 1
                                                    select i).SingleOrDefault();
                                    var tipo_eleccion = "";
                                    if(eleccion.ID_TIPO_ELECCION == 1)
                                    {
                                        tipo_eleccion = "candidatos";
                                    }
                                    if(eleccion.ID_TIPO_ELECCION == 2)
                                    {
                                        tipo_eleccion = "partidos";
                                    }
                                    if(eleccion.ID_TIPO_ELECCION ==3)
                                    {
                                        tipo_eleccion = "propuesta";
                                    }
                                    <h1>Votación para @tipo_eleccion</h1>
                                    <p>Las elecciones para el instituto <strong>"@eleccion.NOMBRE_INSTITUTO"</strong>
                                       dará inicio el día <strong>@eleccion.FECHA_INICIO.ToShortDateString()</strong>
                                        y finalizará el día <strong>@eleccion.FECHA_FIN.ToShortDateString()</strong>
                                        a las <strong>@eleccion.FECHA_FIN.ToShortTimeString()</strong> horas.</p>
                                    <p>
                                        <strong>Descripción de la elección:</strong>
                                        @eleccion.DESCRIPCION
                                    </p>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-xs-12">
                        <div class="span4 offset4 well">
                            <div class="form-wrap">
                                <h1>Inicie sesión con su nombre de usuario</h1>
                                <form role="form" @*action="javascript:;"*@ method="post" id="login-form" autocomplete="off" action="@Url.Action("Login", "Cuenta")">
                                    @*@using (Html.BeginForm("Index","CuentaUsuario", FormMethod.Post))
                                        {*@
                                    <div class="form-group">
                                        <label for="nombre_usuario" class="sr-only">tb_nombreusuario</label>
                                        <input type="text" name="nombre_usuario" id="nombre_usuario" class="form-control" placeholder="Nombre de usuario o CI" value="@Request.Form["nombre_usuario"]" />
                                    </div>
                                    @if (ViewBag.Nmb == 1)
                                    {
                                        <div class="alert alert-danger alert-dismissable">
                                            <strong>ERROR</strong> Debe ingresar su nombre de usuario.
                                        </div>
                                    }
                                    <div class="form-group">
                                        <label for="key" class="sr-only">Clave</label>
                                        <input type="password" name="clave" id="tb_clave" class="form-control" placeholder="Contraseña">
                                    </div>
                                    @if (ViewBag.Clv == 1)
                                    {
                                        <div class="alert alert-danger alert-dismissable">
                                            <strong>ERROR</strong> Debe ingresar su clave.
                                        </div>
                                    }
                                    <p>@ViewBag.Message</p>
                                    @if (ViewBag.TheResult == 2)
                                    {
                                        <div class="alert alert-danger alert-dismissable">
                                            <strong>ERROR</strong> Nombre de usuario o clave incorrecta.
                                        </div>
                                    }

                                    @if (ViewBag.TheResult == 1)
                                    {
                                        <div class="alert alert-danger alert-dismissable">
                                            <strong>ERROR</strong> Su usuario está bloqueado. Desbloquee su cuenta antes de ingresar. Clic @Html.ActionLink("aquí", "Desbloquear", "Cuenta", new { style = "text-decoration:underline;" }) para desbloquear su cuenta.
                                        </div>
                                    }
                                    @*@Html.ActionLink("Aceptar", "Login", new { @class = "btn btn-custom btn-lg btn-block" })*@
                                    <input type="submit" id="btn-login" class="btn btn-custom btn-lg btn-block" value="Aceptar">
                                    @*}*@
                                </form>
                                @Html.ActionLink("¿Olvidaste tu contraseña?", "OlvidoClave", "Cuenta", new { @class = "forget" })
                                @*<label class="forget" data-toggle="modal" data-target=".forget-modal" @Url.Action("RecuperarCuenta","Cuenta")>¿Olvidaste tu contraseña?</label>*@
                                <hr>
                            </div>
                        </div>
                    </div>
                    @*</div>*@ <!-- /.col-xs-12 -->
                </div> <!-- /.row -->
            </div> <!-- /.container -->
        </section>
    </div>
    @*<div class="modal fade forget-modal" tabindex="-1" role="dialog" aria-labelledby="myForgetModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-sm">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">
                            <span aria-hidden="true">×</span>
                            <span class="sr-only">Close</span>
                        </button>
                        <h4 class="modal-title">Recovery password</h4>
                    </div>
                    <div class="modal-body">
                        <p>Type your email account</p>
                        <input type="email" name="recovery-email" id="recovery-email" class="form-control" autocomplete="off">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-custom">Recovery</button>
                    </div>
                </div> <!-- /.modal-content -->
            </div> <!-- /.modal-dialog -->
        </div> <!-- /.modal -->*@
    @Html.Partial("Validacion")
 

</body>
</html>
