
@{
    ViewBag.Title = "CAMBIAR CONTRASEÑA";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Recuperar cuenta - Sistema de Votación</title>
</head>
<body>
    <div id="wrapper">
        <div class="jumbotron">
            <h3> @ViewBag.Title </h3>
        </div>

        <div class="col-lg-12 col-md-12">
            <div class="span4 offset4 well">
                <div class="alert alert-warning alert-dismissable">
                    <strong>¡Advertencia!</strong> Todos los campos deben estar llenos. Si presenta problemas desbloqueando su cuenta, diríjase a su institución educativa.
                </div>
                <form role="form" method="post" id="login-form" autocomplete="off" action="@Url.Action("ClaveCambiada", "Cuenta")">
                    <h5 style="margin-top:15px">Cambie su clave</h5>
                    <div class="form-group">
                        <label for="pwd">Ingrese su nueva contraseña:</label>
                        <input type="password" name="clave_nueva" id="cedula" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="pwd">Repita la contraseña</label>
                        <input type="password" name="clave_confirmar" id="correo" class="form-control">
                    </div>
                    @if (ViewBag.Coinciden == false)
                    {
                        <div class="alert alert-danger alert-dismissable">
                            <strong>ERROR</strong> Las contraseñas no coinciden, por favor inténtelo nuevamente.
                        </div>
                    }
                    @if (ViewBag.Formato == false)
                    {
                        <div class="alert alert-danger alert-dismissable">
                            <strong>ERROR</strong> Recuerde que la contraseña debe contener mayúsculas, minúsculas, números y caracteres.
                        </div>
                    }
                    <input type="submit" id="btn-login" class="btn btn-custom btn-lg btn-block" value="Aceptar" style="margin-bottom:15px">
                </form>
            </div>
        </div>
    </div>
</body>
</html>



