
@{
    ViewBag.Title = "SISTEMA DE VOTACIÓN";
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Inicio - Sistema de Votación Online</title>
</head>
<body>
    <div id="wrapper">
        <div class="jumbotron">
            <h3> @ViewBag.Title </h3>
        </div>
        <div class="col-lg-12 col-md-12">
            @if (ViewBag.EsAdmin == true)
            {
                <div class="alert alert-success alert-dismissable">
                    <strong>¡Ingreso exitoso!</strong> Usted ha ingresado como <strong>administrador</strong>.
                </div>
            }
            <div class="span4 offset4 well">
                <div class="form-wrap">
                    <h1>Votación para candidatos</h1>
                    <p>@ViewBag.Bienvenida</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>


