
@{
    ViewBag.Title = "¿OLVIDASTE TU CONTRASEÑA?";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title> Recuperar cuenta - Sistema de Votación</title>
</head>
<body>
    <div id="wrapper">
        <div class="jumbotron">
            <h3> @ViewBag.Title </h3>
        </div>

        <div class="col-lg-12 col-md-12">
            <div class="span4 offset4 well">
                <form role="form" method="post" id="login-form" autocomplete="off" action="@Url.Action("OlvidoClave", "Cuenta")">
                    <h5 style="margin-TOP:15px">Introduzca su nombre de usuario:</h5>
                    <div class="form-group">
                        <input type="text" name="user_name" id="user_name" class="form-control">
                    </div>
                    @if (ViewBag.Existe == false)
                    {
                        <div class="alert alert-danger alert-dismissable">
                            <strong>ERROR</strong> El nombre de usuario que ingresó, no existe. Por favor, inténtelo nuevamente.
                        </div>
                    }
                    <input type="submit" id="btn-login" class="btn btn-custom btn-lg btn-block" value="Continuar" style="margin-bottom:15px">
                </form>
            </div>
        </div>
    </div>
</body>
</html>


