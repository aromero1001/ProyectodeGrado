
@{
    ViewBag.Title = "RECUPERAR CUENTA";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Recuperar cuenta - Sistema de Votación</title>
</head>
<body>
    <div id="wrapper">
        
        <div class="jumbotron">
            <h3> @ViewBag.Title </h3>
        </div>

        <div class="alert alert-warning alert-dismissable">
            <strong>¡Advertencia!</strong> Todos los campos deben estar llenos. Si presenta problemas desbloqueando su cuenta, diríjase a su institución educativa.
        </div>

        <div class="col-lg-12 col-md-12">
            <div class="span4 offset4 well">
                <form role="form" method="post" id="login-form" autocomplete="off" action="@Url.Action("CambiarClave", "Cuenta")">
                    <h5 style="margin-top:15px">Llene el siguiente formulario para poder desbloquear su cuenta o cambiar su clave</h5>
                    <div class="form-group">
                        <label for="pwd">Nombre de usuario:</label>
                        <input type="text" name="nom_user" id="nom_user" class="form-control" value="@(ViewBag.NombreUsuario)" disabled>
                    </div>
                    <div class="form-group">
                        <label for="pwd">Número de cédula:</label>
                        <input type="text" name="cedula" id="cedula" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="pwd">Correo electrónico:</label>
                        <input type="email" name="correo" id="correo" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="pwd">@ViewBag.Pregunta1</label>
                        <input type="text" name="respuesta1" id="respuesta1" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="pwd">@ViewBag.Pregunta2</label>
                        <input type="text" name="respuesta2" id="respuesta2" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="pwd">@ViewBag.Pregunta3</label>
                        <input type="text" name="respuesta3" id="respuesta3" class="form-control">
                    </div>
                    @if (ViewBag.Respuestas == false)
                    {
                        <div class="alert alert-danger alert-dismissable">
                            <strong>ERROR</strong> Sus datos no son correctos. Por favor, inténtelo nuevamente.
                        </div>
                    }
                    <input type="submit" id="btn-login" class="btn btn-custom btn-lg btn-block" value="Aceptar" style="margin-bottom:15px">
                </form>
            </div>
        </div>
    </div>
</body>
</html>

